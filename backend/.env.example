# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/godaddy_dashboard?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/godaddy_dashboard?retryWrites=true&w=majority

# JWT — use a random 32+ character string
JWT_SECRET=replace-with-a-secure-random-string-min-32-chars

# AES Encryption key — must be exactly 32 characters
ENCRYPTION_KEY=replace-with-exactly-32-char-key!

# Admin credentials (used to seed first login)
ADMIN_PASSWORD=change-this-password

# CORS — comma-separated list of allowed frontend origins
# Production: https://godaddy.v1mobi.com
CORS_ORIGINS=http://localhost:5173,https://godaddy.v1mobi.com,http://godaddy.v1mobi.com

# Auto-sync interval in milliseconds (default: 24h)
APP_SYNC_INTERVAL_MS=86400000
