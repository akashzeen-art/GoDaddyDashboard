# Only for godaddy.v1mobi.com — does NOT change other nginx sites.
# Install:
#   cp deploy/nginx-godaddy-dashboard.conf.example /etc/nginx/sites-available/godaddy-dashboard
#   ln -sf /etc/nginx/sites-available/godaddy-dashboard /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# HTTPS (after HTTP works):
#   certbot --nginx -d godaddy.v1mobi.com -d www.godaddy.v1mobi.com

server {
    listen 80;
    listen [::]:80;
    server_name godaddy.v1mobi.com www.godaddy.v1mobi.com;

    root /var/www/dashboard/godaddy/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Certbot will add a second "server { listen 443 ssl ... }" block automatically.
# Do NOT add "default_server" here — other apps on this VPS stay untouched.
