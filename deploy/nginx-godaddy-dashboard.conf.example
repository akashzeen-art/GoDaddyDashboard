# Copy to: /etc/nginx/sites-available/godaddy-dashboard
# Then: ln -s /etc/nginx/sites-available/godaddy-dashboard /etc/nginx/sites-enabled/
# Replace YOUR_DOMAIN with your real domain or server IP.

# Disable the default site so this vhost is used:
#   rm -f /etc/nginx/sites-enabled/default
#   nginx -t && systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name godaddy.v1mobi.com;

    root /var/www/dashboard/godaddy/frontend/dist;
    index index.html;

    # React SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Spring Boot API
    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
