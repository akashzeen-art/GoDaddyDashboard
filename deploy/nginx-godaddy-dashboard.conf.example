# /etc/nginx/sites-available/godaddy-dashboard
# Only matches godaddy.v1mobi.com — other VPS sites unchanged.

server {
    listen 80;
    listen [::]:80;
    server_name godaddy.v1mobi.com;

    root /var/www/dashboard/godaddy/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTPS: certbot --nginx -d godaddy.v1mobi.com
# (adds 443 block + redirect automatically)
